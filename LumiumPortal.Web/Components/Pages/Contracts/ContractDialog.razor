@using Domain.Enums.Contracts
@using Lumium.Application.Common.Extensions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            @(IsEditMode ? "Izmeni ugovor" : "Dodaj ugovor")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@_validator.ValidateValue">
            <MudStack Spacing="3">
                
                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudAutocomplete T="(Guid Id, string Name)"
                                     @bind-Value="_model.SelectedClient"
                                     Label="Klijent"
                                     SearchFunc="@SearchClients"
                                     ToStringFunc="@(c => c.Name)"
                                     For="@(() => _model.SelectedClient)"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     RequiredError="Klijent je obavezan"
                                     Disabled="@DisableClientSelection"/>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@_model.ContractNumber"
                                          Label="Broj ugovora"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          For="@(() => _model.ContractNumber)"/>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="@_model.MonthlyFee"
                                             Label="Mesečna obaveza (€)"
                                             Required="true"
                                             Min="0"
                                             Step="0.01m"
                                             Format="N2"
                                             Variant="Variant.Outlined"
                                             For="@(() => _model.MonthlyFee)"/>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudSelect @bind-Value="@_model.Status"
                                       Label="Status"
                                       Required="true"
                                       Variant="Variant.Outlined"
                                       For="@(() => _model.Status)">
                                @foreach (var status in Enum.GetValues<ContractStatus>())
                                {
                                    <MudSelectItem T="ContractStatus" Value="@status">
                                        @status.GetDescription()
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect @bind-Value="@_model.Type"
                                       Label="Tip"
                                       Required="true"
                                       Variant="Variant.Outlined"
                                       For="@(() => _model.Type)">
                                @foreach (var type in Enum.GetValues<ContractType>())
                                {
                                    <MudSelectItem T="ContractType" Value="@type">
                                        @type.GetDescription()
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudSelect @bind-Value="@_model.Duration"
                                       Label="Trajanje"
                                       Required="true"
                                       Variant="Variant.Outlined"
                                       For="@(() => _model.Duration)">
                                @foreach (var duration in Enum.GetValues<ContractDuration>())
                                {
                                    <MudSelectItem T="ContractDuration" Value="@duration">
                                        @duration.GetDescription()
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="@_startDate"
                                           Label="Datum početka"
                                           Required="true"
                                           DateFormat="dd.MM.yyyy"
                                           Variant="Variant.Outlined"
                                           Editable="true"/>
                        </MudItem>

                        @if (_model.Duration == ContractDuration.Fixed)
                        {
                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="@_endDate"
                                               Label="Datum završetka"
                                               Required="true"
                                               DateFormat="dd.MM.yyyy"
                                               Variant="Variant.Outlined"
                                               Editable="true"
                                               MinDate="_startDate"/>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudTextField @bind-Value="@_model.Notes"
                                  Label="Komentar"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  For="@(() => _model.Notes)"/>
                </MudPaper>

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" 
                   Disabled="_isSubmitting"
                   Style="text-transform: uppercase;">
            Otkaži
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@HandleSubmit"
                   Disabled="_isSubmitting"
                   Style="text-transform: uppercase;">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Čuvanje...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Sačuvaj" : "Dodaj")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>