@using Domain.Enums.Contracts
@using Lumium.Application.Common.Extensions

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Validation="@(_validator.ValidateValue)" ValidationDelay="0">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect @bind-Value="_model.ClientId"
                               Label="Klijent"
                               T="Guid?"
                               For="@(() => _model.ClientId)"
                               Immediate="true"
                               Required="true">
                        @foreach (var client in _clients)
                        {
                            <MudSelectItem Value="@((Guid?)client.Id)">@client.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ContractNumber"
                                  Label="Broj ugovora"
                                  For="@(() => _model.ContractNumber)"
                                  Immediate="true"
                                  Required="true"/>
                </MudItem>

                <MudItem xs="12">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.MonthlyFee"
                                     Label="Mesečna obaveza"
                                     For="@(() => _model.MonthlyFee)"
                                     Immediate="true"
                                     Format="N2"
                                     Min="0"
                                     Required="true"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Status"
                               Label="Status"
                               For="@(() => _model.Status)">
                        @foreach (var status in Enum.GetValues<ContractStatus>())
                        {
                            <MudSelectItem Value="@status">@status.GetDescription()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Type"
                               Label="Tip ugovora"
                               For="@(() => _model.Type)">
                        @foreach (var type in Enum.GetValues<ContractType>())
                        {
                            <MudSelectItem Value="@type">@type.GetDescription()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.subtitle2" Class="mb-3">Trajanje ugovora</MudText>
                        <MudRadioGroup @bind-Value="_model.Duration" T="ContractDuration">
                            <MudStack Spacing="2">
                                <MudRadio T="ContractDuration" Value="ContractDuration.Fixed" Color="Color.Primary">
                                    <MudText>Vremenski određen</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ugovor ima tačan datum završetka</MudText>
                                </MudRadio>
                                <MudRadio T="ContractDuration" Value="ContractDuration.Indefinite" Color="Color.Primary">
                                    <MudText>Na neodređeno</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ugovor nema određen rok trajanja</MudText>
                                </MudRadio>
                            </MudStack>
                        </MudRadioGroup>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="_model.Duration == ContractDuration.Fixed ? 6 : 12">
                    <MudDatePicker @bind-Date="_startDate"
                                   Label="Datum početka"
                                   Required="true"
                                   DateFormat="dd.MM.yyyy"/>
                </MudItem>

                @if (_model.Duration == ContractDuration.Fixed)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_endDate"
                                       Label="Datum završetka"
                                       Required="true"
                                       DateFormat="dd.MM.yyyy"
                                       MinDate="_startDate"/>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="Komentar"
                                  For="@(() => _model.Notes)"
                                  Immediate="true"/>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Otkaži</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="HandleSubmit"
                   Disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Čuvam...</MudText>
            }
            else
            {
                <MudText>Sačuvaj</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>