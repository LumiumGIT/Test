@page "/documents"
@using Domain.Enums.Documents
@using Lumium.Application.Common.Extensions
@using Lumium.Application.Features.Documents.DTOs
@using LumiumPortal.Web.Components.Shared
@using LumiumPortal.Web.Helpers
@inherits SecureComponentBase

@if (_isLoading)
{
    <LoadingIndicator Text="Učitavam dokumente..."/>
}
else
{
    @* Header *@
    <MudText Typo="Typo.h3" GutterBottom="true">Dokumenta</MudText>
    <MudText Class="mb-4" Color="Color.Default">Upravljajte dokumentima i linkovima za klijente</MudText>

    @* Stats Cards *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption"
                                 Style="text-transform: uppercase; font-weight: 500;">
                            Ukupno
                        </MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@_documents.Count</MudText>
                    </MudStack>
                    <MudPaper Elevation="0" Class="pa-2" Style="border-radius: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Medium"/>
                    </MudPaper>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption"
                                 Style="text-transform: uppercase; font-weight: 500;">
                            Zvanična
                        </MudText>
                        <MudText Typo="Typo.h4" Color="Color.Info">@OfficialCount</MudText>
                    </MudStack>
                    <MudPaper Elevation="0" Class="pa-2" Style="border-radius: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Info" Size="Size.Medium"/>
                    </MudPaper>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption"
                                 Style="text-transform: uppercase; font-weight: 500;">
                            Prateća
                        </MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success">@SupportingCount</MudText>
                    </MudStack>
                    <MudPaper Elevation="0" Class="pa-2" Style="border-radius: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Success" Size="Size.Medium"/>
                    </MudPaper>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption"
                                 Style="text-transform: uppercase; font-weight: 500;">
                            Poslednjih 7 dana
                        </MudText>
                        <MudText Typo="Typo.h4" Color="Color.Secondary">@RecentCount</MudText>
                    </MudStack>
                    <MudPaper Elevation="0" Class="pa-2" Style="border-radius: 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.NewReleases" Color="Color.Secondary" Size="Size.Medium"/>
                    </MudPaper>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Toolbar *@
    <MudPaper Class="mb-4 pa-4" Elevation="1">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudButton OnClick="@OpenAddDocumentDialog"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Dodaj dokument
            </MudButton>
        </MudStack>
    </MudPaper>

    @* DataGrid *@
    <MudPaper Class="pa-4">
        <MudDataGrid T="DocumentDto"
                     Items="@_documents"
                     Class="center-table"
                     Striped="true" 
                     Hover="true"
                     Dense="true"
                     ReadOnly="true"
                     RowsPerPage="10"
                     Filterable="true"
                     SortMode="SortMode.Multiple"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     FilterCaseSensitivity="@DataGridFilterCaseSensitivity.CaseInsensitive"
                     Hideable="false"
                     Bordered="true">
            <Columns>
                <PropertyColumn Property="d => d.Name" Title="Naziv"/>

                <PropertyColumn Property="d => d.ClientName" Title="Klijent" />
                
                <PropertyColumn Property="d => d.Category" Title="Kategorija">
                    <CellTemplate>
                        <MudChip Color="@DocumentHelper.GetCategoryColor(context.Item.Category)" Size="Size.Small">
                            @context.Item.Category.GetDescription()
                        </MudChip>
                    </CellTemplate>
                    <FilterTemplate>
                        <EnumColumnFilter TItem="DocumentDto"
                                          TEnum="DocumentCategory"
                                          Context="@context"
                                          ValueSelector="@(client => client.Category)"
                                          PopoverWidth="250"/>
                    </FilterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="d => d.UploadedAt" Title="Datum dodavanja" Filterable="false">
                    <CellTemplate>
                        @context.Item.UploadedAt.ToString("dd.MM.yyyy HH:mm")
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="d => d.Description" Title="Opis"/>

                <TemplateColumn Title="Otvori dokument" Filterable="false" Sortable="false">
                    <CellTemplate>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="@(() => OpenDocument(context.Item.Url))">
                                Otvori
                            </MudButton>
                    </CellTemplate>
                </TemplateColumn>
                
                <TemplateColumn Title="Obriši" Filterable="false" Sortable="false">
                    <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenDeleteDialog(context.Item))"/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            
            <PagerContent>
                <MudDataGridPager T="DocumentDto"
                                  InfoFormat="{first_item}-{last_item} od {all_items}"
                                  RowsPerPageString="Redova po stranici:"/>
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
}