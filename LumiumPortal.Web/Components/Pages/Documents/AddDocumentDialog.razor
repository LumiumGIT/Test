@using Domain.Enums.Documents
@using Lumium.Application.Common.Extensions

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Validation="@_validator.ValidateValue">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect @bind-Value="_model.ClientId"
                               Label="Klijent"
                               T="Guid?"
                               For="@(() => _model.ClientId)"
                               Immediate="true"
                               Required="true"
                               Clearable="true"
                               Placeholder="Izaberite klijenta">
                        @foreach (var client in _clients)
                        {
                            <MudSelectItem Value="@((Guid?)client.Id)">@client.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Naziv dokumenta"
                                  For="@(() => _model.Name)"
                                  Immediate="true"
                                  Required="true"/>
                </MudItem>

                @* <MudItem xs="12"> *@
                @*     <MudSelect @bind-Value="_model.Category" *@
                @*                Label="Kategorija" *@
                @*                T="DocumentCategory" *@
                @*                For="@(() => _model.Category)" *@
                @*                Immediate="true" *@
                @*                Required="true"> *@
                @*          *@
                @*         $1$ Zvanična dokumentacija #1# *@
                @*         <MudListSubheader>Zvanična dokumentacija</MudListSubheader> *@
                @*         @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c < 10)) *@
                @*         { *@
                @*             <MudSelectItem T="DocumentCategory" Value="@category">@category.GetDescription()</MudSelectItem> *@
                @*         } *@
                @*          *@
                @*         $1$ Prateća dokumentacija #1# *@
                @*         <MudDivider Class="my-2" /> *@
                @*         <MudListSubheader>Prateća dokumentacija</MudListSubheader> *@
                @*         @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c >= 10 && (int)c < 99)) *@
                @*         { *@
                @*             <MudSelectItem T="DocumentCategory" Value="@category">@category.GetDescription()</MudSelectItem> *@
                @*         } *@
                @* *@
                @*         $1$ Ostalo (99) #1# *@
                @*         @if (Enum.GetValues<DocumentCategory>().Any(c => (int)c == 99)) *@
                @*         { *@
                @*             <MudDivider Class="my-2" /> *@
                @*             <MudSelectItem T="DocumentCategory" Value="DocumentCategory.Other">@DocumentCategory.Other.GetDescription()</MudSelectItem> *@
                @*         } *@
                @*     </MudSelect> *@
                @* </MudItem> *@
                
                <MudItem xs="12">
                    <MudSelect @bind-Value="_model.Category"
                               Label="Kategorija"
                               T="DocumentCategory"
                               For="@(() => _model.Category)"
                               Immediate="true"
                               Required="true">
        
                        @* Zvanična dokumentacija (0-9) *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">ZVANIČNA DOKUMENTACIJA</MudText>
                        </MudSelectItem>
                        @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c < 10))
                        {
                            <MudSelectItem T="DocumentCategory" Value="@category">@category.GetDescription()</MudSelectItem>
                        }
        
                        @* Razdvajač *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudDivider />
                        </MudSelectItem>
        
                        @* Prateća dokumentacija (10-98) *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 600;">PRATEĆA DOKUMENTACIJA</MudText>
                        </MudSelectItem>
                        @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c >= 10 && (int)c < 99))
                        {
                            <MudSelectItem T="DocumentCategory" Value="@category">@category.GetDescription()</MudSelectItem>
                        }
        
                        @* Ostalo *@
                        @if (Enum.GetValues<DocumentCategory>().Any(c => (int)c == 99))
                        {
                            <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                <MudDivider />
                            </MudSelectItem>
                            <MudSelectItem T="DocumentCategory" Value="DocumentCategory.Other">@DocumentCategory.Other.GetDescription()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Url"
                                  Label="Link ka dokumentu"
                                  For="@(() => _model.Url)"
                                  Immediate="true"
                                  Required="true"
                                  Placeholder="https://drive.google.com/..."/>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Opis (opciono)"
                                  For="@(() => _model.Description)"
                                  Immediate="true"/>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Otkaži</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@HandleSubmit"
                   Disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Čuvam...</MudText>
            }
            else
            {
                <MudText>Sačuvaj</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>