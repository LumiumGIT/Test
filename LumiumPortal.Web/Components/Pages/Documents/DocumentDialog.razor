@using Domain.Enums.Documents
@using Lumium.Application.Common.Extensions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            @(IsEditMode ? "Izmeni dokument" : "Dodaj dokument")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Validation="@_validator.ValidateValue">
            <MudStack Spacing="3">
                
                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudAutocomplete T="(Guid Id, string Name)"
                                     @bind-Value="_model.SelectedClient"
                                     Label="Klijent"
                                     SearchFunc="@SearchClients"
                                     ToStringFunc="@(c => c.Name)"
                                     For="@(() => _model.SelectedClient)"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Placeholder="Izaberite klijenta..."
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary"
                                     DebounceInterval="300"
                                     Immediate="true"
                                     Required="true"
                                     Disabled="@DisableClientSelection">
                    </MudAutocomplete>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="@_model.Name"
                                      Label="Naziv dokumenta"
                                      For="@(() => _model.Name)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Required="true"/>

                        <MudSelect @bind-Value="@_model.Category"
                                   Label="Kategorija"
                                   T="DocumentCategory"
                                   For="@(() => _model.Category)"
                                   Variant="Variant.Outlined"
                                   Immediate="true"
                                   Required="true">

                            <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
                                    ZVANIČNA DOKUMENTACIJA
                                </MudText>
                            </MudSelectItem>
                            @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c < 10))
                            {
                                <MudSelectItem T="DocumentCategory" Value="@category">
                                    @category.GetDescription()
                                </MudSelectItem>
                            }

                            <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                <MudDivider/>
                            </MudSelectItem>

                            <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 600;">
                                    PRATEĆA DOKUMENTACIJA
                                </MudText>
                            </MudSelectItem>
                            @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c >= 10 && (int)c < 99))
                            {
                                <MudSelectItem T="DocumentCategory" Value="@category">
                                    @category.GetDescription()
                                </MudSelectItem>
                            }

                            @if (Enum.GetValues<DocumentCategory>().Any(c => (int)c == 99))
                            {
                                <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                    <MudDivider/>
                                </MudSelectItem>
                                <MudSelectItem T="DocumentCategory" Value="DocumentCategory.Other">
                                    @DocumentCategory.Other.GetDescription()
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="@_model.Url"
                                      Label="Link ka dokumentu"
                                      For="@(() => _model.Url)"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Required="true"
                                      Placeholder="https://drive.google.com/..."/>

                        <MudTextField @bind-Value="@_model.Description"
                                      Label="Opis (opciono)"
                                      For="@(() => _model.Description)"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      Immediate="true"/>
                    </MudStack>
                </MudPaper>

            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" 
                   Disabled="@_isSubmitting"
                   Style="text-transform: uppercase;">
            Otkaži
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@HandleSubmit"
                   Disabled="@_isSubmitting"
                   Style="text-transform: uppercase;">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <span>Čuvam...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Sačuvaj" : "Dodaj")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>