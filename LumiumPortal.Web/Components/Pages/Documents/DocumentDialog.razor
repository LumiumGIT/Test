@using Domain.Enums.Documents
@using Lumium.Application.Common.Extensions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(IsEditMode ? "Izmeni dokument" : "Dodaj dokument")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model" Validation="@_validator.ValidateValue">
            <MudGrid>
                <MudItem xs="12">
                    <MudAutocomplete T="(Guid Id, string Name)"
                                     @bind-Value="_model.SelectedClient"
                                     Label="Klijent"
                                     SearchFunc="@SearchClients"
                                     ToStringFunc="@(c => c.Name)"
                                     For="@(() => _model.SelectedClient)"
                                     Clearable="true"
                                     Placeholder="Izaberite klijenta..."
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     AdornmentColor="Color.Primary"
                                     DebounceInterval="300"
                                     Immediate="true"
                                     Required="true"
                                     Disabled="@DisableClientSelection">
                    </MudAutocomplete>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Naziv dokumenta"
                                  For="@(() => _model.Name)"
                                  Immediate="true"
                                  Required="true"/>
                </MudItem>

                <MudItem xs="12">
                    <MudSelect @bind-Value="_model.Category"
                               Label="Kategorija"
                               T="DocumentCategory"
                               For="@(() => _model.Category)"
                               Immediate="true"
                               Required="true">

                        @* Zvanična dokumentacija (0-9) *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">ZVANIČNA
                                DOKUMENTACIJA
                            </MudText>
                        </MudSelectItem>
                        @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c < 10))
                        {
                            <MudSelectItem T="DocumentCategory"
                                           Value="@category">@category.GetDescription()</MudSelectItem>
                        }

                        @* Razdvajač *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudDivider/>
                        </MudSelectItem>

                        @* Prateća dokumentacija (10-98) *@
                        <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 600;">PRATEĆA
                                DOKUMENTACIJA
                            </MudText>
                        </MudSelectItem>
                        @foreach (var category in Enum.GetValues<DocumentCategory>().Where(c => (int)c >= 10 && (int)c < 99))
                        {
                            <MudSelectItem T="DocumentCategory"
                                           Value="@category">@category.GetDescription()</MudSelectItem>
                        }

                        @* Ostalo *@
                        @if (Enum.GetValues<DocumentCategory>().Any(c => (int)c == 99))
                        {
                            <MudSelectItem T="DocumentCategory" Disabled="true" Value="default(DocumentCategory)">
                                <MudDivider/>
                            </MudSelectItem>
                            <MudSelectItem T="DocumentCategory"
                                           Value="DocumentCategory.Other">@DocumentCategory.Other.GetDescription()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Url"
                                  Label="Link ka dokumentu"
                                  For="@(() => _model.Url)"
                                  Immediate="true"
                                  Required="true"
                                  Placeholder="https://drive.google.com/..."/>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Opis (opciono)"
                                  For="@(() => _model.Description)"
                                  Immediate="true"/>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Otkaži</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@HandleSubmit"
                   Disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Čuvam...</MudText>
            }
            else
            {
                <MudText>Sačuvaj</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>