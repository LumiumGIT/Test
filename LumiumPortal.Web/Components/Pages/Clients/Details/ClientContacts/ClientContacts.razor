@using Lumium.Application.Common.Extensions
<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Kontakti</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Add"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="@OpenAddDialog"
                   Style="text-transform: uppercase;">
            Dodaj kontakt
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
    }
    else if (_contacts.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-8">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Description"
                         Size="Size.Large"
                         Color="Color.Default"
                         Style="font-size: 36px; opacity: 0.3;"/>
                <MudText Typo="Typo.h6" Color="Color.Default">
                    Nema kontakata
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    Kliknite na "Dodaj kontakt" da dodate prvi kontakt
                </MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_contacts"
                  Class="center-table"
                  Striped="true"
                  Bordered="true"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0"
                  Dense="true">
            <HeaderContent>
                <MudTh>Tip</MudTh>
                <MudTh>Ime i prezime</MudTh>
                <MudTh>Pozicija</MudTh>
                <MudTh>Telefon</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Izmeni</MudTh>
                <MudTh>Obriši</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudChip T="string"
                             Size="Size.Small"
                             Style="@($"background-color: {GetTypeColor(context.Type)}; color: white;")">
                        @context.Type.GetDescription()
                    </MudChip>
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>@context.Phone</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditContact(context))"/>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteContact(context))"/>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>