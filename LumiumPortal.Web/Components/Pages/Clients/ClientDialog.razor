@using Domain.Enums.Clients
@using Lumium.Application.Common.Extensions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 600;">
            @(IsEditMode ? "Izmeni klijenta" : "Dodaj klijenta")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="@_model" Validation="@(_validator.ValidateValue)" ValidationDelay="0">
            <MudStack Spacing="3">
                
                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Business" 
                                     Color="Color.Primary" 
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin: 0;">
                                Osnovni podaci
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="@_model.Name"
                                              Label="Naziv klijenta"
                                              For="@(() => _model.Name)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="@_model.LegalForm"
                                           Label="Pravni tip"
                                           For="@(() => _model.LegalForm)"
                                           Variant="Variant.Outlined">
                                    @foreach (var form in Enum.GetValues<LegalForm>())
                                    {
                                        <MudSelectItem Value="@form">@form.GetDescription()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="@_model.BusinessActivityId"
                                           Label="Oblast rada"
                                           For="@(() => _model.BusinessActivityId)"
                                           Variant="Variant.Outlined">
                                    @foreach (var activity in _businessActivities)
                                    {
                                        <MudSelectItem Value="@activity.Id">@activity.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="@_model.TaxNumber"
                                              Label="Matični broj"
                                              For="@(() => _model.TaxNumber)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="@_model.TaxIdentificationNumber"
                                              Label="PIB"
                                              For="@(() => _model.TaxIdentificationNumber)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="4" Class="d-flex align-center">
                                <MudSwitch @bind-Value="@_model.IsPdv"
                                           Label="PDV"
                                           Color="Color.Primary"/>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.People" 
                                     Color="Color.Primary" 
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin: 0;">
                                Odgovorna lica
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="@_model.ResponsiblePerson"
                                              Label="Zaduženo lice"
                                              For="@(() => _model.ResponsiblePerson)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="@_model.BackupPerson"
                                              Label="Zamena u odsustvu"
                                              For="@(() => _model.BackupPerson)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.ContactMail" 
                                     Color="Color.Primary" 
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin: 0;">
                                Kontakt informacije
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="@_model.Address"
                                              Label="Adresa"
                                              For="@(() => _model.Address)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="@_model.Director"
                                              Label="Direktor"
                                              For="@(() => _model.Director)"
                                              Variant="Variant.Outlined"
                                              Immediate="true"/>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="@_model.CountryId"
                                           Label="Država"
                                           For="@(() => _model.CountryId)"
                                           Variant="Variant.Outlined">
                                    @foreach (var country in _countries)
                                    {
                                        <MudSelectItem Value="@country.Id">@country.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                @* ✅ SEKCIJA 4 - Dodatne opcije (sa grey background) *@
                <MudPaper Elevation="0" Class="pa-4" Style="background-color: var(--mud-palette-table-striped); border-radius: 8px;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Settings" 
                                     Color="Color.Primary" 
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin: 0;">
                                Dodatne opcije
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.EcoTax"
                                           Label="Eko taksa"
                                           Color="Color.Primary"/>
                            </MudItem>

                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.BeneficialOwners"
                                           Label="Stvarni vlasnici"
                                           Color="Color.Primary"/>
                            </MudItem>

                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.Croso"
                                           Label="CROSO"
                                           Color="Color.Primary"/>
                            </MudItem>

                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.Pep"
                                           Label="PEP"
                                           Color="Color.Primary"/>
                            </MudItem>

                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.WingsTemplate"
                                           Label="Wings šablon"
                                           Color="Color.Primary"/>
                            </MudItem>

                            <MudItem xs="6" md="3">
                                <MudSwitch @bind-Value="@_model.IsActive"
                                           Label="Aktivan"
                                           Color="Color.Primary"/>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="pa-4" Style="background-color: transparent;">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" 
                                     Color="Color.Warning" 
                                     Size="Size.Small"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin: 0;">
                                Procena rizika
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudSelect @bind-Value="@_model.RiskLevel"
                                           Label="Nivo rizika"
                                           For="@(() => _model.RiskLevel)"
                                           Variant="Variant.Outlined">
                                    @foreach (var level in Enum.GetValues<RiskLevel>())
                                    {
                                        <MudSelectItem Value="@level">@level.GetDescription()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" 
                   Variant="Variant.Text"
                   Style="text-transform: uppercase;">
            Otkaži
        </MudButton>
        <MudButton OnClick="@HandleSubmit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_isSubmitting"
                   Style="text-transform: uppercase;">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <span>Čuvanje...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Sačuvaj" : "Dodaj")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>